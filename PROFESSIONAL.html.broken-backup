<!DOCTYPE html>
<!--
  Alex Lamberti – Portfolio-Experience (eine Datei, keine Pflicht-Bibliotheken)

  WordPress / Elementor – grobe Zuordnung:
  - Globale Farben & Abstände      → Elementor: Site Settings / Custom CSS (:root-Variablen)
  - Hintergrund + Grid + Partikel → Section Hintergrund + HTML-Widget (Canvas) oder weglassen
  - Fortschrittsleiste             → entfernt (nur noch Header)
  - Header (Logo + Menü)           → Theme Builder Header oder Section „sticky“
  - Vollbild-Menü                  → Popup / Off-Canvas oder Overlay-Section + Trigger
  - „slides-root“ + .slide         → je Kapitel eine Elementor-Section (IDs wie #slide-home)
  - .glass-card, .card-grid        → Container + Spalten + innere Boxen (Backdrop-Filter beachten)
  - Kapitelwahl nur über Header-Menü / DNA-Karten (keine untere Kapitelleiste)
-->
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Alex Lamberti | BUSINESS – Business Welt</title>
  <meta name="description" content="Portfolio von Alex Lamberti: Digital Marketing, Websites, Markenwirkung, SEO, Strategie und professionale Umsetzung." />
  <!-- Keine Webfonts nötig. Optional in WP: Schrift „Manrope“ oder „Inter“ per Theme/Elementor nachladen. -->
  <style>
    /* =============================================================================
       1. Design-Tokens (für Elementor: hier Farben/Radii nach „Globale Farben“ übernehmen)
       ============================================================================= */
    :root {
      --navy-0: #050810;
      --navy-1: #0a1220;
      --navy-2: #111d32;
      --ice: #8ec5ff;
      --ice-dim: rgba(142, 197, 255, 0.45);
      --ice-glow: rgba(120, 185, 255, 0.22);
      --sand: #d4b896;
      --sand-soft: rgba(212, 184, 150, 0.35);
      --text: #e8eef8;
      --text-muted: rgba(232, 238, 248, 0.68);
      --glass: rgba(18, 32, 56, 0.42);
      --glass-border: rgba(142, 197, 255, 0.18);
      --radius-lg: 28px;
      --radius-md: 18px;
      /*
        HEADER-ABSTAND (Höhe bis Folienbeginn):
        --header-air-top / --header-air-bottom = Luft unter Safe-Area & unter der Zeile.
        Wert erhöhen → gesamter Header + Menü weiter nach unten.
      */
      --header-air-top: 22px;
      --header-air-bottom: 16px;
      --header-inner-row: 52px;
      --header-h: calc(
        env(safe-area-inset-top, 0px) + var(--header-air-top) + var(--header-inner-row) + var(--header-air-bottom)
      );
      --dock-h: env(safe-area-inset-bottom, 0px);
      --ease: cubic-bezier(0.22, 1, 0.36, 1);
      /*
        DNA-BLOCK: genau eine Bildschirmhöhe unter dem Header → erst Scrollen zeigt „Marketing mit Wirkung“.
        svh = stabiler auf Mobil; als Fallback dient dieselbe Rechnung mit vh in älteren Browsern.
      */
      --hero-dna-h: calc(100svh - var(--header-h) - var(--dock-h));
      /*
        DNA-GRÖSSE / Orbit: Inline --lift / --z-depth an jedem .dna-slide (HTML).
      */
      --dna-orbit-radius: min(50vw, 440px);
      --dna-img-max-width: min(1240px, 96vw);
    }

    @supports not (height: 100svh) {
      :root {
        --hero-dna-h: calc(100vh - var(--header-h) - var(--dock-h));
      }
    }

    /* =============================================================================
       2. Basis-Reset & Typo
       ============================================================================= */
    *, *::before, *::after { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background: var(--navy-0);
      color: var(--text);
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    button {
      font: inherit;
      color: inherit;
      cursor: pointer;
      border: none;
      background: none;
    }
    img { max-width: 100%; display: block; height: auto; }
    :focus-visible {
      outline: 2px solid var(--ice);
      outline-offset: 3px;
    }
    .btn:focus-visible, .btn-menu:focus-visible, .btn-close:focus-visible, .dock-card:focus-visible,
    .dna-slide:focus-visible {
      outline-offset: 2px;
    }

    /* =============================================================================
       3. Dekor: Verlauf, Raster, Lichtlinien, Partikel-Canvas (reine Optik)
       ============================================================================= */
    .bg-root {
      position: fixed;
      inset: 0;
      z-index: 0;
      background:
        radial-gradient(1200px 800px at 15% -10%, rgba(142, 197, 255, 0.09), transparent 55%),
        radial-gradient(900px 600px at 90% 20%, rgba(212, 184, 150, 0.06), transparent 50%),
        linear-gradient(180deg, var(--navy-0), var(--navy-1) 45%, #060a12);
      pointer-events: none;
    }

    .bg-grid {
      position: fixed;
      inset: 0;
      z-index: 0;
      opacity: 0.055;
      background-image:
        linear-gradient(rgba(142, 197, 255, 0.5) 1px, transparent 1px),
        linear-gradient(90deg, rgba(142, 197, 255, 0.5) 1px, transparent 1px);
      background-size: 56px 56px;
      pointer-events: none;
      mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 20%, transparent 75%);
    }

    #particle-canvas {
      position: fixed;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      opacity: 0.55;
    }

    .light-beams {
      position: fixed;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      overflow: hidden;
    }
    .light-beams::before,
    .light-beams::after {
      content: "";
      position: absolute;
      width: 140%;
      height: 2px;
      left: -20%;
      background: linear-gradient(90deg, transparent, var(--ice-dim), transparent);
      opacity: 0.35;
      animation: beam-drift 18s var(--ease) infinite;
    }
    .light-beams::before { top: 22%; transform: rotate(-8deg); animation-delay: -4s; }
    .light-beams::after { top: 38%; transform: rotate(-5deg); opacity: 0.22; animation-duration: 24s; }

    @keyframes beam-drift {
      0%, 100% { transform: translateX(-5%) rotate(-8deg); opacity: 0.2; }
      50% { transform: translateX(5%) rotate(-6deg); opacity: 0.38; }
    }

    /* =============================================================================
       4. Chrome: Header, Vollbild-Navigation (Fortschrittsleiste entfernt)
       ============================================================================= */

    .site-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 51;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      box-sizing: border-box;
      /* HEADER-ABSTAND nach unten: zusätzlich zu --header-air-* in :root */
      padding-top: calc(env(safe-area-inset-top, 0px) + var(--header-air-top));
      padding-bottom: var(--header-air-bottom);
      padding-left: max(clamp(12px, 3vw, 32px), env(safe-area-inset-left));
      padding-right: max(clamp(8px, 2.2vw, 22px), env(safe-area-inset-right));
      pointer-events: none;
    }
    .site-header > * { pointer-events: auto; }
    .header-left {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      /* Abstand Name ↔ E-Mail ↔ Tel (24–32px) */
      column-gap: clamp(24px, 3.5vw, 32px);
      row-gap: 10px;
      min-width: 0;
      flex: 1;
    }
    /* Name + Kontakt: gleiche Typo wie «Alex Lamberti» (kein Muted-Grau) */
    .brand-mark,
    .header-meta {
      font-weight: 700;
      letter-spacing: -0.03em;
      font-size: clamp(0.82rem, 2vw, 0.92rem);
      line-height: 1.25;
      color: var(--text);
      flex-shrink: 0;
    }
    .brand-mark span { color: var(--ice); font-weight: 600; }
    .header-meta {
      text-decoration: none;
      white-space: nowrap;
      transition: color 0.2s;
    }
    .header-meta:hover,
    .header-meta:focus-visible {
      color: var(--ice);
    }
    .btn-menu {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      border-radius: 999px;
      background: var(--glass);
      border: 1px solid var(--glass-border);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      font-weight: 600;
      font-size: clamp(0.84rem, 2vw, 0.92rem);
      flex-shrink: 0;
      margin-right: 4px;
      transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
    }
    .btn-menu:hover {
      transform: translateY(-1px);
      border-color: rgba(142, 197, 255, 0.35);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
    }
    .btn-menu-lines {
      display: grid;
      gap: 4px;
      width: 19px;
    }
    .btn-menu-lines span {
      height: 2px;
      background: var(--text);
      border-radius: 2px;
      opacity: 0.85;
    }

    .menu-overlay {
      position: fixed;
      inset: 0;
      z-index: 60;
      background: rgba(4, 8, 14, 0.72);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
      display: grid;
      align-content: center;
      justify-items: center;
      padding: 32px;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.45s var(--ease), visibility 0.45s;
    }
    .menu-overlay.open {
      opacity: 1;
      visibility: visible;
    }
    .menu-panel {
      width: min(520px, 100%);
      border-radius: var(--radius-lg);
      border: 1px solid var(--glass-border);
      background: rgba(12, 22, 40, 0.65);
      padding: clamp(28px, 5vw, 40px);
      box-shadow: 0 40px 100px rgba(0, 0, 0, 0.55);
      transform: translateY(16px) scale(0.98);
      transition: transform 0.5s var(--ease);
    }
    .menu-overlay.open .menu-panel {
      transform: translateY(0) scale(1);
    }
    .menu-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 28px;
    }
    .menu-kicker {
      font-size: 0.72rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ice-dim);
      margin: 0 0 8px;
      font-weight: 600;
    }
    .menu-title {
      margin: 0;
      font-size: 1.35rem;
      font-weight: 600;
      letter-spacing: -0.02em;
    }
    .btn-close {
      padding: 10px 16px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      font-weight: 600;
      font-size: 0.82rem;
      transition: background 0.2s;
    }
    .btn-close:hover { background: rgba(255, 255, 255, 0.06); }
    .menu-links {
      display: grid;
      gap: 4px;
    }
    .menu-links a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 4px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      font-size: 1.05rem;
      font-weight: 500;
      letter-spacing: -0.01em;
      transition: color 0.2s, padding-left 0.25s var(--ease);
    }
    .menu-links a::after {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--ice);
      opacity: 0;
      transform: scale(0.5);
      transition: opacity 0.2s, transform 0.25s var(--ease);
    }
    .menu-links a:hover { color: var(--ice); padding-left: 6px; }
    .menu-links a.active {
      color: var(--ice);
      font-weight: 600;
    }
    .menu-links a.active::after {
      opacity: 1;
      transform: scale(1);
    }

    /* =============================================================================
       5. Kapitel-„Folien“: nur eine .slide.active sichtbar (in WP: Sections ein-/ausblenden per JS oder separate URLs)
       ============================================================================= */
    main.slides-root {
      position: relative;
      z-index: 10;
      height: 100vh;
      height: 100dvh;
      padding-top: var(--header-h);
      padding-bottom: var(--dock-h);
    }

    .slide {
      position: absolute;
      inset: 0;
      top: var(--header-h);
      bottom: var(--dock-h);
      padding: clamp(20px, 4vw, 56px) clamp(18px, 4vw, 64px) 24px;
      overflow-y: auto;
      overflow-x: hidden;
      opacity: 0;
      visibility: hidden;
      transform: translate3d(0, 18px, 0) scale(0.992);
      transform-origin: 50% 40%;
      transition:
        opacity 0.65s var(--ease),
        transform 0.65s var(--ease),
        visibility 0.65s;
      scrollbar-width: thin;
      scrollbar-color: rgba(142, 197, 255, 0.35) transparent;
    }
    .slide.active {
      opacity: 1;
      visibility: visible;
      transform: translate3d(0, 0, 0) scale(1);
      z-index: 2;
    }

    .slide-inner {
      max-width: 1180px;
      margin: 0 auto;
      min-height: min-content;
    }

    .glass-card {
      background: var(--glass);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
    }

    /* --- Sektion: Home (Full-Width DNA-Hero, darunter Text + Bild) --- */
    .home-layout {
      display: grid;
      grid-template-columns: 1fr minmax(280px, 420px);
      gap: clamp(28px, 5vw, 64px);
      align-items: center;
    }
    @media (max-width: 960px) {
      .home-layout { grid-template-columns: 1fr; }
    }

    /* Startseite: kein Zusatz-Padding oben/unten — sonst „Leer-Scroll“ vor dem Intro */
    #slide-home.slide {
      padding-left: 0;
      padding-right: 0;
      padding-top: 0;
      padding-bottom: clamp(10px, 2.5vw, 20px);
    }
    .slide-inner--home {
      max-width: none;
      margin: 0;
      padding: 0;
    }

    /*
      Hero-DNA: feste Blockhöhe = eine Viewport-Höhe unter Header → kein endloses Scrollen im leeren Bereich.
      Erst darunter: .home-main-block („Marketing mit Wirkung“).
    */
    .home-hero-experience {
      position: relative;
      width: 100%;
      box-sizing: border-box;
      height: var(--hero-dna-h);
      max-height: var(--hero-dna-h);
      min-height: min(240px, var(--hero-dna-h));
      display: flex;
      flex-direction: column;
      padding: clamp(6px, 1.2vh, 16px) 0 0;
      overflow: hidden;
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
      background:
        radial-gradient(ellipse 125% 85% at 48% 32%, rgba(48, 98, 185, 0.26), transparent 56%),
        radial-gradient(ellipse 65% 55% at 78% 58%, rgba(95, 165, 240, 0.09), transparent 52%),
        linear-gradient(185deg, rgba(5, 10, 22, 0.96) 0%, rgba(4, 8, 18, 0.72) 100%);
      border-bottom: 1px solid rgba(142, 197, 255, 0.09);
      box-shadow: inset 0 -20px 44px rgba(0, 0, 0, 0.24);
    }
    /* Partikel nur im Hero (Canvas), liegt unter DNA, über Hintergrund */
    .dna-particles-canvas {
      position: absolute;
      inset: 0;
      z-index: 1;
      width: 100%;
      height: 100%;
      pointer-events: none;
      opacity: 0.75;
    }



    /* Premium-DNA: virtueller Tech-Hintergrund mit lebendigem Canvas, Scanlines und Glow */
    .home-hero-experience::before {
      content: "";
      position: absolute;
      inset: -1px;
      z-index: 1;
      pointer-events: none;
      background:
        radial-gradient(circle at 24% 34%, rgba(0, 194, 255, 0.16), transparent 34%),
        radial-gradient(circle at 72% 58%, rgba(54, 126, 255, 0.14), transparent 42%),
        linear-gradient(115deg, transparent 0 38%, rgba(142, 197, 255, 0.055) 48%, transparent 62% 100%);
      mix-blend-mode: screen;
    }
    .home-hero-experience::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(142, 197, 255, 0.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(142, 197, 255, 0.045) 1px, transparent 1px),
        linear-gradient(180deg, transparent, rgba(5, 8, 16, 0.38));
      background-size: 64px 64px, 64px 64px, 100% 100%;
      opacity: 0.42;
      mask-image: radial-gradient(ellipse 82% 66% at 50% 46%, black 18%, transparent 78%);
    }
    .dna-premium-canvas {
      position: absolute;
      inset: 0;
      z-index: 3;
      width: 100%;
      height: 100%;
      pointer-events: none;
      opacity: 0.98;
      mix-blend-mode: screen;
    }
    .dna-unified-scene { z-index: 5; }
    .dna-holo-arm {
      opacity: 0.22;
      filter: blur(1px) saturate(1.35) brightness(1.18);
      animation: dnaHoloFloat 9s ease-in-out infinite;
    }
    @keyframes dnaHoloFloat {
      0%, 100% { transform: translate(-50%, -50%) rotateZ(-11deg) scale(0.80); }
      50% { transform: translate(-50%, -48.5%) rotateZ(-9.5deg) scale(0.84); }
    }
    .dna-visual-stack:not(.dna-stack--alpha) .dna-asset--soft,
    .dna-visual-stack.dna-stack--alpha .dna-asset--soft {
      opacity: 0.62;
      filter: blur(34px) brightness(1.35) saturate(1.35);
      mix-blend-mode: screen;
    }
    .dna-visual-stack:not(.dna-stack--alpha) .dna-asset--main,
    .dna-visual-stack.dna-stack--alpha .dna-asset--main {
      opacity: 0.86;
      mix-blend-mode: screen;
      filter:
        brightness(1.22)
        contrast(1.16)
        saturate(1.25)
        drop-shadow(0 0 24px rgba(102, 210, 255, 0.72))
        drop-shadow(0 0 74px rgba(42, 122, 255, 0.42));
    }
    .dna-ring-scene { z-index: 7; }
    .dna-slide {
      background: linear-gradient(145deg, rgba(9, 18, 38, 0.78), rgba(9, 31, 62, 0.62));
      box-shadow:
        0 18px 44px rgba(0, 0, 0, 0.48),
        inset 0 1px 0 rgba(255, 255, 255, 0.07),
        0 0 0 1px rgba(102, 210, 255, 0.06);
    }
    .dna-slide.is-front {
      background: linear-gradient(145deg, rgba(17, 52, 95, 0.94), rgba(10, 24, 52, 0.92));
      box-shadow:
        0 28px 64px rgba(0, 0, 0, 0.55),
        0 0 46px rgba(96, 205, 255, 0.30),
        0 0 92px rgba(40, 120, 255, 0.14),
        inset 0 1px 0 rgba(255, 255, 255, 0.14);
    }

    /* 3D-Szene: füllt den DNA-Block flexibel; Höhe kommt vom Helix-Container (nicht aus überschüssigem min-height) */
    .dna-unified-scene {
      position: relative;
      z-index: 2;
      flex: 1 1 auto;
      min-height: 0;
      perspective: min(2400px, 160vw);
      perspective-origin: 50% 42%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: clamp(4px, 1vh, 12px) clamp(12px, 4vw, 56px) clamp(4px, 1vh, 10px);
    }
    .dna-orbit-group {
      position: relative;
      width: min(100%, 1320px);
      flex: 0 1 auto;
      height: min(100%, min(52vh, 520px));
      max-height: 100%;
      min-height: min(240px, 100%);
      transform-style: preserve-3d;
      transform: rotateY(var(--dna-rot, 0deg));
      will-change: transform;
    }
    .dna-orbit-group.is-dragging {
      cursor: grabbing;
    }

    /* DNA: fix; bei Bild MIT Alphakanal Klasse «dna-stack--alpha» am Stack setzen (blend aus). Ohne Alpha: screen hellt den Strang auf dunklem Seitenhintergrund auf. */
    /* DNA: leichte Skalierung, damit Helix + Karten in --hero-dna-h bleiben (vorher zu stark verkleinert) */
    .dna-holo-arm {
      position: absolute;
      left: 50%;
      top: 44%;
      width: var(--dna-img-max-width);
      transform-style: preserve-3d;
      transform: translate(-50%, -50%) rotateZ(-11deg) scale(0.82);
      transform-origin: center center;
      pointer-events: none;
      z-index: 6;
    }
    .dna-visual-stack {
      position: relative;
      width: 100%;
      aspect-ratio: 600 / 265;
      transform-style: preserve-3d;
    }
    .dna-visual-stack.dna-use-fallback .dna-layer--fallback-svg {
      display: block;
    }
    .dna-visual-stack.dna-use-fallback .dna-layer--raster {
      display: none;
    }
    .dna-layer {
      position: absolute;
      left: 50%;
      top: 50%;
      transform-style: preserve-3d;
      pointer-events: none;
    }
    /* Nur zwei Bildebenen: weiches Licht hinten, Referenzbild vorne — keine Rahmen-/Glass-Box */
    .dna-layer--raster.dna-layer--soft {
      width: 100%;
      transform: translate3d(-50%, -50%, -18px) scale(1.03);
    }
    .dna-layer--raster.dna-layer--main {
      width: 100%;
      transform: translate3d(-50%, -50%, 6px);
    }
    .dna-asset {
      width: 100%;
      height: auto;
      display: block;
    }
    .dna-visual-stack:not(.dna-stack--alpha) .dna-asset--soft {
      opacity: 0.32;
      filter: blur(18px);
      mix-blend-mode: screen;
    }
    .dna-visual-stack:not(.dna-stack--alpha) .dna-asset--main {
      mix-blend-mode: screen;
      filter: drop-shadow(0 0 20px rgba(100, 180, 255, 0.4));
    }
    .dna-visual-stack.dna-stack--alpha .dna-asset--soft {
      opacity: 0.4;
      filter: blur(16px);
      mix-blend-mode: normal;
    }
    .dna-visual-stack.dna-stack--alpha .dna-asset--main {
      mix-blend-mode: normal;
      filter: drop-shadow(0 0 24px rgba(110, 185, 255, 0.35));
    }
    .dna-layer--fallback-svg {
      display: none;
      width: var(--dna-img-max-width);
      transform: translate3d(-50%, -50%, 20px);
    }
    .dna-holo-svg-wrap {
      filter:
        drop-shadow(0 0 20px rgba(120, 200, 255, 0.55))
        drop-shadow(0 0 50px rgba(60, 140, 255, 0.35));
    }
    .dna-holo-svg {
      width: 100%;
      height: auto;
      display: block;
      overflow: visible;
    }

    /* Folienring: grösserer Radius (--dna-orbit-radius), stärkere Y-/Z-Variation via Inline-Variablen */
    .dna-ring-scene {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 0;
      height: 0;
      transform: translate(-50%, -50%);
      transform-style: preserve-3d;
      z-index: 4;
    }
    .dna-ring {
      position: absolute;
      left: 0;
      top: 0;
      width: 0;
      height: 0;
      transform-style: preserve-3d;
    }
    .dna-slide {
      position: absolute;
      left: 50%;
      top: 50%;
      width: min(188px, 36vw);
      min-height: 52px;
      padding: 20px 18px;
      border-radius: 22px;
      border: 1px solid rgba(142, 197, 255, 0.22);
      background: rgba(10, 18, 36, 0.82);
      backdrop-filter: blur(calc(8px + var(--card-blur, 4px)));
      -webkit-backdrop-filter: blur(calc(8px + var(--card-blur, 4px)));
      font-family: inherit;
      font-size: clamp(0.82rem, 2.1vw, 0.95rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      color: rgba(232, 238, 248, 0.78);
      text-align: center;
      line-height: 1.25;
      cursor: pointer;
      transform-style: preserve-3d;
      opacity: var(--card-opacity, 0.88);
      transform:
        translate(-50%, calc(-50% + var(--lift, 0px)))
        rotateY(calc(var(--i) * var(--dna-slot, 60deg)))
        rotateX(calc(var(--tilt-x, 0deg)))
        translateZ(calc(var(--dna-orbit-radius) + var(--z-depth, 0px)))
        scale(var(--card-scale, 0.96));
      box-shadow:
        0 16px 40px rgba(0, 0, 0, 0.45),
        inset 0 1px 0 rgba(255, 255, 255, 0.05);
      transition:
        color 0.45s var(--ease),
        border-color 0.45s var(--ease),
        box-shadow 0.5s var(--ease),
        background 0.45s var(--ease),
        opacity 0.5s var(--ease),
        filter 0.5s var(--ease);
    }
    .dna-slide:hover {
      color: var(--text);
      border-color: rgba(142, 197, 255, 0.38);
    }
    .dna-slide.is-front {
      color: var(--ice);
      border-color: rgba(142, 197, 255, 0.55);
      background: rgba(16, 34, 68, 0.92);
      box-shadow:
        0 26px 56px rgba(0, 0, 0, 0.5),
        0 0 40px var(--ice-glow),
        inset 0 1px 0 rgba(255, 255, 255, 0.12);
    }

    /* Unter dem Hero: wenig Abstand — Intro schliesst dichter an die DNA-Szene an */
    .home-main-block {
      max-width: 1180px;
      margin: 0 auto;
      padding: clamp(10px, 2vw, 22px) clamp(18px, 4vw, 64px) clamp(14px, 2vw, 28px);
    }
    .home-layout--intro {
      grid-template-columns: 1fr minmax(260px, 400px);
      align-items: center;
      gap: clamp(24px, 5vw, 56px);
    }
    @media (max-width: 960px) {
      .home-layout--intro {
        grid-template-columns: 1fr;
      }
    }
    .home-portrait-card {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid var(--glass-border);
      aspect-ratio: 4 / 5;
      width: 100%;
      max-width: min(400px, 100%);
      max-height: min(68vh, 560px);
      margin: 0 auto;
      min-height: 240px;
      box-shadow:
        0 0 0 1px rgba(142, 197, 255, 0.08),
        0 36px 90px rgba(0, 0, 0, 0.45),
        inset 0 0 60px rgba(142, 197, 255, 0.05);
      isolation: isolate;
    }
    .home-portrait-card img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      display: block;
      z-index: 0;
    }
    .home-portrait-card::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: radial-gradient(ellipse 90% 55% at 50% 18%, rgba(142, 197, 255, 0.12), transparent 55%);
      mix-blend-mode: screen;
    }

    .hero-identity {
      position: relative;
      border-radius: 32px;
      aspect-ratio: 4 / 5;
      max-height: min(72vh, 620px);
      margin: 0 auto;
      isolation: isolate;
      overflow: hidden;
      border: 1px solid var(--glass-border);
      box-shadow:
        0 0 0 1px rgba(142, 197, 255, 0.08),
        0 40px 100px rgba(0, 0, 0, 0.5),
        inset 0 0 80px rgba(142, 197, 255, 0.06);
      transition: transform 0.4s var(--ease);
    }
    .hero-identity::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 20%, var(--ice-glow), transparent 65%);
      z-index: 2;
      pointer-events: none;
      mix-blend-mode: screen;
    }
    .hero-identity::after {
      content: "";
      position: absolute;
      inset: -40%;
      background: conic-gradient(from 210deg, transparent, rgba(142, 197, 255, 0.04), transparent 40%);
      z-index: 1;
      animation: halo-spin 28s linear infinite;
      pointer-events: none;
    }
    @keyframes halo-spin {
      to { transform: rotate(360deg); }
    }
    .hero-identity img.hero-photo {
      position: relative;
      z-index: 0;
      width: 100%;
      height: 100%;
      min-height: min(52vh, 520px);
      object-fit: cover;
      object-position: center center;
    }
    .hero-identity .photo-caption {
      position: absolute;
      left: 14px;
      right: 14px;
      bottom: 14px;
      z-index: 5;
      border: 1px solid rgba(142, 197, 255, 0.22);
      border-radius: 16px;
      background: rgba(8, 12, 22, 0.72);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      padding: 14px 16px;
    }
    .hero-identity .photo-caption strong {
      display: block;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .contact-visual {
      position: relative;
      display: block;
      width: 100%;
      min-height: 280px;
      aspect-ratio: 4 / 5;
      max-height: min(72vh, 560px);
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid var(--glass-border);
    }
    .contact-visual img.contact-photo {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      min-height: 0;
      object-fit: cover;
      object-position: center 30%;
      z-index: 0;
    }
    .contact-visual .photo-caption {
      position: absolute;
      left: 12px;
      right: 12px;
      bottom: 12px;
      z-index: 2;
      border: 1px solid rgba(142, 197, 255, 0.2);
      border-radius: 14px;
      background: rgba(8, 12, 22, 0.7);
      backdrop-filter: blur(12px);
      padding: 12px 14px;
    }
    .contact-visual .photo-caption strong {
      display: block;
      font-size: 0.95rem;
      font-weight: 700;
    }
    .hero-placeholder {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      padding: 24px;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.9rem;
      line-height: 1.5;
      background: linear-gradient(145deg, var(--navy-2), var(--navy-1));
    }

    .home-copy .eyebrow {
      font-size: 0.75rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ice);
      font-weight: 700;
      margin: 0 0 14px;
    }
    .home-copy h1 {
      font-size: clamp(2.2rem, 5.5vw, 3.6rem);
      font-weight: 700;
      letter-spacing: -0.04em;
      line-height: 1.08;
      margin: 0 0 14px;
      max-width: 14ch;
    }
    .home-copy .lead {
      font-size: clamp(1.05rem, 2.1vw, 1.35rem);
      line-height: 1.45;
      color: var(--text);
      max-width: 28ch;
      margin: 0 0 14px;
      font-weight: 500;
    }
    .home-copy .more {
      font-size: 0.98rem;
      line-height: 1.75;
      color: var(--text-muted);
      max-width: 40em;
      margin: 0 0 28px;
    }
    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 22px;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.92rem;
      border: 1px solid var(--glass-border);
      background: rgba(255, 255, 255, 0.04);
      transition: transform 0.25s, background 0.25s, border-color 0.25s, box-shadow 0.25s;
    }
    .btn:hover {
      transform: translateY(-2px);
      border-color: rgba(142, 197, 255, 0.4);
      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35);
    }
    .btn-primary {
      background: linear-gradient(135deg, rgba(142, 197, 255, 0.25), rgba(142, 197, 255, 0.08));
      border-color: rgba(142, 197, 255, 0.45);
      color: var(--text);
    }

    .chapter-label {
      font-size: 0.75rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--sand);
      font-weight: 600;
      margin-bottom: 14px;
    }
    h2.section-title {
      font-size: clamp(1.85rem, 4vw, 3rem);
      font-weight: 700;
      letter-spacing: -0.035em;
      line-height: 1.12;
      margin: 0 0 20px;
      max-width: 22em;
    }
    .prose {
      font-size: 1.02rem;
      line-height: 1.75;
      color: var(--text-muted);
      max-width: 40em;
      margin: 0 0 16px;
    }

    /* --- Sektion: Über mich (Tabs + Bildmodus) --- */
    .about-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(280px, 400px);
      gap: clamp(24px, 4vw, 48px);
      align-items: start;
    }
    .about-grid--text-only {
      grid-template-columns: 1fr;
      max-width: 48rem;
    }
    @media (max-width: 900px) {
      .about-grid { grid-template-columns: 1fr; }
    }
    .about-visual {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      aspect-ratio: 3 / 4;
      max-height: 520px;
      border: 1px solid var(--glass-border);
    }
    .about-visual img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: object-position 0.6s var(--ease), transform 0.8s var(--ease);
    }
    .about-visual[data-mode="p"] img { object-position: center 25%; }
    .about-visual[data-mode="w"] img { object-position: center 45%; }
    .about-visual[data-mode="k"] img { object-position: center 60%; }

    .persona-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 28px 0 18px;
    }
    .persona-tabs button {
      padding: 10px 16px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      transition: 0.25s;
    }
    .persona-tabs button:hover { color: var(--text); border-color: rgba(142, 197, 255, 0.35); }
    .persona-tabs button.on {
      color: var(--navy-0);
      background: var(--ice);
      border-color: transparent;
    }
    .persona-panel h3 {
      margin: 0 0 10px;
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .persona-panel p {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.7;
      color: var(--text-muted);
    }
    .persona-body p {
      margin: 0 0 1rem;
      font-size: 0.98rem;
      line-height: 1.75;
      color: var(--text-muted);
    }
    .persona-body p:last-child {
      margin-bottom: 0;
    }

    .persona-body ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 12px;
    }
    .persona-body li {
      position: relative;
      padding-left: 24px;
      font-size: 0.98rem;
      line-height: 1.75;
      color: var(--text-muted);
    }
    .persona-body li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.72em;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--ice);
      box-shadow: 0 0 14px var(--ice-glow);
    }

    /* --- Werte / Stärken / Projekte: Kartenraster; .card-grid--three = max. 3 Spalten --- */
    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
      gap: 16px;
      margin-top: 28px;
    }
    .card-grid--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    @media (max-width: 960px) {
      .card-grid--three {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (max-width: 600px) {
      .card-grid--three {
        grid-template-columns: 1fr;
      }
    }
    .value-card, .skill-card, .project-card {
      padding: 22px 22px 20px;
      border-radius: var(--radius-md);
      border: 1px solid var(--glass-border);
      background: rgba(12, 22, 40, 0.5);
      transition: transform 0.35s var(--ease), border-color 0.35s, box-shadow 0.35s;
    }
    .value-card:hover, .skill-card:hover, .project-card:hover {
      transform: translateY(-4px);
      border-color: rgba(142, 197, 255, 0.35);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    }
    .value-card h3, .skill-card h3, .project-card h3 {
      margin: 0 0 10px;
      font-size: 1.08rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .value-card p, .skill-card p {
      margin: 0;
      font-size: 0.92rem;
      line-height: 1.65;
      color: var(--text-muted);
    }
    .motto-heading {
      margin: 36px 0 12px;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--text);
    }
    .motto {
      margin-top: 0;
      padding: 22px 26px;
      border-left: 3px solid var(--sand-soft);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
      background: rgba(212, 184, 150, 0.06);
      font-size: 0.95rem;
      line-height: 1.65;
      color: var(--text-muted);
      font-style: italic;
      max-width: 42em;
    }

    .project-card .block {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.55;
      margin: 10px 0;
    }
    .project-card .block strong {
      display: block;
      color: var(--text);
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 4px;
      font-weight: 700;
    }
    .project-card .btn-open {
      margin-top: 14px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      font-size: 0.88rem;
      color: var(--ice);
    }
    .project-card .btn-open:hover { text-decoration: underline; text-underline-offset: 4px; }

    /* --- Erfahrung: Zeitstrahl + Zeugnislisten --- */
    .timeline {
      margin-top: 28px;
      position: relative;
      padding-left: 24px;
    }
    .timeline::before {
      content: "";
      position: absolute;
      left: 6px;
      top: 6px;
      bottom: 6px;
      width: 2px;
      background: linear-gradient(180deg, var(--ice-dim), rgba(142, 197, 255, 0.08));
      border-radius: 2px;
    }
    .tl-item {
      position: relative;
      padding: 18px 0 18px 20px;
    }
    .tl-item::before {
      content: "";
      position: absolute;
      left: -21px;
      top: 26px;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--navy-0);
      border: 2px solid var(--ice);
      box-shadow: 0 0 14px var(--ice-glow);
    }
    .tl-item time {
      display: block;
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--sand);
      font-weight: 700;
      margin-bottom: 6px;
    }
    .tl-item h3 {
      margin: 0 0 6px;
      font-size: 1.05rem;
      font-weight: 700;
    }
    .tl-item p {
      margin: 0;
      font-size: 0.92rem;
      line-height: 1.65;
      color: var(--text-muted);
    }

    .zeugnis-block {
      margin-top: 40px;
      padding-top: 32px;
      border-top: 1px solid rgba(142, 197, 255, 0.12);
    }
    .zeugnis-block h3 {
      margin: 0 0 8px;
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .zeugnis-block > .prose {
      margin-bottom: 18px;
    }
    .zeugnis-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 12px;
    }
    .zeugnis-row {
      padding: 16px 18px;
      border-radius: var(--radius-md);
      border: 1px solid var(--glass-border);
      background: rgba(12, 22, 40, 0.45);
    }
    .zeugnis-row .firma {
      display: block;
      font-weight: 700;
      font-size: 0.98rem;
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }
    .zeugnis-row .position {
      display: block;
      font-size: 0.9rem;
      line-height: 1.55;
      color: var(--text-muted);
    }

    .exp-block-title {
      font-size: 0.68rem;
      letter-spacing: 0.42em;
      text-transform: uppercase;
      color: var(--sand);
      font-weight: 700;
      margin: 2.5rem 0 1.25rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid rgba(142, 197, 255, 0.15);
    }
    .exp-block-title:first-child {
      margin-top: 0;
    }

    /* --- Kontakt --- */
    .contact-layout {
      display: grid;
      grid-template-columns: 1fr minmax(260px, 340px);
      gap: 28px;
      align-items: stretch;
    }
    @media (max-width: 800px) {
      .contact-layout { grid-template-columns: 1fr; }
    }
    .contact-actions {
      display: grid;
      gap: 12px;
      margin-top: 24px;
    }
    .contact-actions a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 18px 20px;
      border-radius: var(--radius-md);
      border: 1px solid var(--glass-border);
      background: rgba(255, 255, 255, 0.04);
      font-weight: 600;
      transition: 0.25s;
    }
    .contact-actions a:hover {
      border-color: rgba(142, 197, 255, 0.4);
      background: rgba(142, 197, 255, 0.08);
    }
    .contact-actions a span:last-child {
      font-size: 1.1rem;
      opacity: 0.65;
    }

    /* Kapitelleiste: am Viewport fixiert (nicht mit Scroll der Folien), eigenes z-index unter Overlay-Menü */
    .chapter-dock {
      position: fixed !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100%;
      max-width: 100vw;
      z-index: 50 !important;
      padding-top: 4px;
      padding-bottom: max(8px, env(safe-area-inset-bottom));
      padding-left: max(clamp(10px, 2.5vw, 22px), env(safe-area-inset-left));
      padding-right: max(clamp(10px, 2.5vw, 22px), env(safe-area-inset-right));
      background: linear-gradient(180deg, transparent, rgba(4, 7, 14, 0.94) 28%);
      pointer-events: none;
      transform: translateZ(0);
      -webkit-transform: translateZ(0);
    }
    .dock-scene {
      perspective: 900px;
      display: flex;
      justify-content: center;
      align-items: flex-end;
      gap: 7px;
      flex-wrap: nowrap;
      overflow-x: auto;
      padding: 4px 2px 2px;
      pointer-events: auto;
      scrollbar-width: none;
      cursor: grab;
      -webkit-overflow-scrolling: touch;
    }
    .dock-scene:active { cursor: grabbing; }
    .dock-scene::-webkit-scrollbar { display: none; }
    .dock-card {
      flex: 0 0 auto;
      width: min(100px, 20vw);
      padding: 9px 8px;
      border-radius: 14px;
      border: 1px solid rgba(142, 197, 255, 0.12);
      background: rgba(12, 20, 38, 0.78);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      font-size: 0.68rem;
      font-weight: 700;
      text-align: center;
      line-height: 1.25;
      letter-spacing: -0.01em;
      transform-style: preserve-3d;
      transition:
        transform 0.5s var(--ease),
        opacity 0.45s,
        border-color 0.35s,
        box-shadow 0.35s;
      opacity: 0.55;
      transform: translateZ(-30px) rotateX(12deg) scale(0.92);
    }
    .dock-card:hover { opacity: 0.9; }
    .dock-card.is-active {
      opacity: 1;
      border-color: rgba(142, 197, 255, 0.55);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45), 0 0 24px var(--ice-glow);
      transform: translateZ(26px) rotateX(4deg) scale(1.06);
    }
    .dock-card.is-near {
      opacity: 0.78;
      transform: translateZ(0) rotateX(8deg) scale(0.97);
    }

    /* =============================================================================
       6. Responsive: Tablet & Smartphone (Breakpoints bewusst wenige)
       ============================================================================= */
    @media (max-width: 1024px) {
      .card-grid:not(.card-grid--three) {
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
      }
    }
    @media (max-width: 768px) {
      :root {
        --header-inner-row: 52px;
        --dock-h: env(safe-area-inset-bottom, 0px);
      }
      .slide {
        padding: 16px clamp(14px, 4vw, 24px) 20px;
      }
      .menu-panel {
        max-height: min(90vh, 720px);
        overflow-y: auto;
      }
      .dock-card {
        width: min(100px, 19vw);
        padding: 10px 8px;
        font-size: 0.68rem;
      }
      .header-left {
        column-gap: clamp(20px, 4vw, 28px);
      }
    }
    @media (max-width: 480px) {
      :root {
        /* zweizeiliges Header-Layout: höhere Zeilenreserve */
        --header-inner-row: 92px;
        --dock-h: env(safe-area-inset-bottom, 0px);
      }
      .header-left {
        flex-direction: column;
        align-items: flex-start;
        row-gap: 10px;
        column-gap: 0;
      }
      .header-meta {
