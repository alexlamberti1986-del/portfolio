# Alex Lamberti Portfolio — Umgebungsvariablen (Vorlage)
# Kopiere diese Datei nach .env nur falls du später serverseitige Integrationen ergänzt.
# Für die aktuelle statische Webseite sind KEINE Umgebungsvariablen erforderlich.

# --- Optional: Vercel (nur bei serverseitigen Erweiterungen) ---
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# --- Optional: Analytics / Monitoring (falls später eingebunden) ---
# ANALYTICS_ID=

# --- Optional: Formular-Backend (falls später eingebunden) ---
# FORM_ENDPOINT=
# FORM_API_KEY=
