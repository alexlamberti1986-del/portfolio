    { "source": "/freiraum/kontakt", "destination": "/index.html" },
    { "source": "/freiraum/offerte", "destination": "/index.html" },
    { "source": "/projekte", "destination": "/index.html" },
    { "source": "/leistungen", "destination": "/index.html" },
    { "source": "/ueber-mich", "destination": "/index.html" },
    { "source": "/kontakt", "destination": "/index.html" },
    { "source": "/offerte", "destination": "/index.html" },
    { "source": "/impressum", "destination": "/impressum.html" },
    { "source": "/datenschutz", "destination": "/datenschutz.html" },
    { "source": "/webdesign", "destination": "/webdesign.html" },
    { "source": "/digital-marketing", "destination": "/digital-marketing.html" },
    { "source": "/digitale-strategie", "destination": "/digitale-strategie.html" },
    { "source": "/(nexora|professional|freiraum|multiversum)/assets/(.*)", "destination": "/assets/$2" },
    { "source": "/(nexora|professional|freiraum|multiversum)/MULTIVERSUM.html", "destination": "/MULTIVERSUM.html" },
    { "source": "/(nexora|professional|freiraum|multiversum)/NEXORA.html", "destination": "/NEXORA.html" },
    { "source": "/(nexora|professional|freiraum|multiversum)/PROFESSIONAL.html", "destination": "/PROFESSIONAL.html" },
    { "source": "/(nexora|professional|freiraum|multiversum)/FREIRAUM.html", "destination": "/FREIRAUM.html" }
  ],
  "redirects": [
    { "source": "/3-Welten-Master-iframe.html", "destination": "/", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/projects", "destination": "/projekte", "permanent": true },
    { "source": "/contact", "destination": "/kontakt", "permanent": true },
    { "source": "/about", "destination": "/ueber-mich", "permanent": true },
    { "source": "/about-me", "destination": "/ueber-mich", "permanent": true },
    { "source": "/profil", "destination": "/leistungen", "permanent": true },
    { "source": "/profile", "destination": "/leistungen", "permanent": true },
    { "source": "/werte", "destination": "/ueber-mich", "permanent": true },
    { "source": "/values", "destination": "/ueber-mich", "permanent": true },
    { "source": "/staerken", "destination": "/leistungen", "permanent": true },
    { "source": "/strengths", "destination": "/leistungen", "permanent": true },
    { "source": "/erfahrung", "destination": "/ueber-mich", "permanent": true },
    { "source": "/experience", "destination": "/ueber-mich", "permanent": true },
    { "source": "/arbeitsweise", "destination": "/ueber-mich", "permanent": true },
    { "source": "/workstyle", "destination": "/ueber-mich", "permanent": true },
    { "source": "/motivation", "destination": "/ueber-mich", "permanent": true },
    { "source": "/why", "destination": "/ueber-mich", "permanent": true },
    { "source": "/faq", "destination": "/ueber-mich", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/(multiversum|nexora|professional|freiraum|projekte|leistungen|ueber-mich|kontakt|offerte|impressum|datenschutz|webdesign|digital-marketing|digitale-strategie)(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
